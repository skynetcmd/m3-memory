# Keep shell scripts + Python as LF on all platforms so Linux/macOS hook
# execution isn't broken by Windows CRLF on a mixed-OS checkout.
# Text files normalize to LF in the repo; native line endings in the
# working tree are left to git's autocrlf default.
*.sh       text eol=lf
*.py       text eol=lf
*.ps1      text eol=crlf
# launchd plists and systemd units are consumed by Unix service managers and
# must be LF. Without this, a Windows checkout with core.autocrlf=true writes
# CRLF and systemd rejects the unit ("Invalid section header") — a breakage
# that is invisible on the machine that authored the file.
*.service  text eol=lf
*.plist    text eol=lf
# Same reasoning, one layer out: a Dockerfile with CRLF breaks `docker build` on
# Linux, and a CRLF shell rc / .env is sourced with trailing \r on every value
# (`command not found: openclaw\r`). These are LF today only by git's
# content-based default, not by policy — pin them so a contributor with
# core.autocrlf=true cannot commit CRLF into a file a Linux user must execute.
Dockerfile text eol=lf
*.example  text eol=lf
*.env      text eol=lf
# Generated SVGs (e.g. docs/star-history.svg) are byte-compared by their
# generator to avoid spurious commits — pin LF so the committed file matches
# what the generator writes on any runner, regardless of core.autocrlf.
*.svg      text eol=lf

# The homelab-dashboard icon cache holds RUNTIME-FETCHED icon blobs (SVG and
# PNG). Files are now named by their true content type (see get_icon in
# backend/main.py), so `*.png binary` / `*.svg text` handle them correctly. This
# blanket rule is belt-and-suspenders: force the whole cache dir to binary so a
# future mis-extensioned blob can never be eol-mangled (which previously left
# PNG-as-svg files permanently "modified" and broke stash pop / merge).
examples/homelab-dashboard/backend/cache/** binary

# Git hooks are extensionless shell scripts — must stay LF so they execute
# on Linux/macOS after a Windows checkout.
.githooks/* text eol=lf

# Binaries: never convert.
*.db       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
*.gguf     binary

# GGUF model assets under _assets/models/ are tracked via Git LFS — they're
# hundreds of MB each. Cloning without LFS yields a small pointer file;
# `git lfs pull` materializes the real bytes. `m3 embedder install` detects
# unmaterialized pointers and prints actionable guidance.
_assets/models/*.gguf filter=lfs diff=lfs merge=lfs -text
*.tar.gz   binary
*.zip      binary
