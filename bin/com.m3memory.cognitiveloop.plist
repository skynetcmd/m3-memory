<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  m3-memory Cognitive Loop — macOS launchd agent template.

  Installed by bin/install_schedules.py, which substitutes [M3_MEMORY_ROOT]
  and [M3_PYTHON] and writes the result to
  ~/Library/LaunchAgents/com.m3memory.cognitiveloop.plist.

  NOTE: ProgramArguments deliberately does NOT pass the background flag. launchd
  manages the process directly; the loop must run in the foreground or
  KeepAlive would lose track of the real worker after the double-fork.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.m3memory.cognitiveloop</string>
    <key>ProgramArguments</key>
    <array>
        <string>[M3_PYTHON]</string>
        <string>[M3_MEMORY_ROOT]/bin/m3_cognitive_loop.py</string>
        <string>--interval</string>
        <string>300</string>
        <string>--log-file</string>
        <string>[M3_MEMORY_ROOT]/logs/cognitive_loop.log</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- File-descriptor headroom (defense-in-depth). The real protection is the
         connection-pool reuse fix in the loop; launchd's default soft limit (256)
         is what turned any FD growth into a fast "Too many open files" collapse. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <!-- Was KeepAlive={Crashed:true}: restart on an ABNORMAL exit only, to avoid
         respawn-looping on EXIT_ALREADY_RUNNING (4) when another instance holds
         the single-instance lock.

         2026-08-09: that left the loop dead for 4h. An upgrade raises HALT_m3,
         the loop checkpoints and exits 0 — a CLEAN exit, precisely the case
         Crashed-only ignores — and the installer never kickstarts it back. The
         embed-server survived the same upgrade only because it uses
         KeepAlive=true.

         Now unconditional, with ThrottleInterval bounding the exit-4 respawn
         the old setting was avoiding: one retry per minute, which self-corrects
         as soon as the competing instance exits. com.m3memory.loopwatchdog is
         the second layer, for a loop that is alive but wedged (KeepAlive cannot
         see that at all). -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>[M3_MEMORY_ROOT]/logs/cognitive_loop.log</string>
    <key>StandardErrorPath</key>
    <string>[M3_MEMORY_ROOT]/logs/cognitive_loop.log</string>
</dict>
</plist>
