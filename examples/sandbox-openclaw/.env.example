# OpenClaw Sandbox Environment
# Copy to .env and fill in your values. Never commit the filled-in .env.

# -- m3 memory over native MCP (streamable-http) --
# The container reaches m3 on the HOST. It cannot use a stdio MCP server: this
# image ships OpenClaw only -- no m3 install, and the host's bin/memory_bridge.py
# is not mounted -- so a stdio `command` would have nothing to launch.
#
# On the HOST, once:
#   m3 serve --generate-token          # mints + stores the token, prints it once
# then run the endpoint:
#   m3 serve --host 0.0.0.0 --port 8080 --public-host host.docker.internal
#
# --host 0.0.0.0 is required (the 127.0.0.1 default is unreachable from the
# container). --public-host is ALSO required, and is easy to miss: the transport
# allowlists the bind host plus loopback, so a request arriving with
# `Host: host.docker.internal:8080` is rejected with 421 BEFORE auth runs.
# Verified by inspecting the allowlist both ways.
#
# Bearer auth is mandatory and NOT waived for loopback -- m3 refuses to start the
# HTTP transport without a token of at least 32 characters.
#
# This file is only the container-injection mechanism. The token's real home is
# m3's own credential store (env -> OS keyring -> encrypted vault), which is
# where --generate-token puts it; paste it here only to hand it to the container.
M3_SERVE_TOKEN=REPLACE_WITH_OUTPUT_OF_m3_serve_--generate-token

# -- OpenClaw gateway --
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STRING

# -- Optional: distributed backends, only if you run Postgres/Chroma --
# m3 needs NONE of these; SQLite on the host is the default. Configuration lives
# under M3_CONFIG_ROOT (default ~/.m3/config) -- NOT the retired ~/m3-memory/.env
# that an earlier version of this file pointed at.
# SYNC_TARGET_IP=YOUR_SERVER_IP
# POSTGRES_SERVER=YOUR_SERVER_IP
# CHROMA_BASE_URL=http://YOUR_SERVER_IP:8000
# PG_URL=postgresql://agent_os:REPLACE_WITH_YOUR_PASSWORD@YOUR_SERVER_IP:5432/agent_memory

# -- API Keys (resolved from keychain if not set) --
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=
# X_API_KEY=
